<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MiGYM">

        <!-- Pantalla 1: Login (Actividad Principal de Inicio) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MiGYM">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Pantalla 2: Registro -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/titulo_registro"
            android:theme="@style/Theme.MiGYM" />

        <!-- Pantalla 3: Lista de Rutinas -->
        <activity
            android:name=".ListActivity"
            android:exported="false"
            android:label="@string/titulo_lista_rutinas"
            android:theme="@style/Theme.MiGYM" />

        <!-- Pantalla 4: Agregar Rutina -->
        <activity
            android:name=".AddActivity"
            android:exported="false"
            android:label="@string/titulo_agregar"
            android:theme="@style/Theme.MiGYM" />

        <!-- Pantalla 5: Detalle de Rutina -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:label="@string/titulo_detalle"
            android:theme="@style/Theme.MiGYM" />

        <!-- Pantalla 6: Asistente IA (Gemini) -->
        <activity
            android:name=".IaActivity"
            android:exported="false"
            android:label="@string/titulo_ia"
            android:theme="@style/Theme.MiGYM" />

        <!-- Compatibilidad MainActivity opcional -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

    </application>

</manifest>