<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tema Base Material 3 (Modo Claro) -->
    <style name="Theme.MiGYM" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Colores Primarios y Secundarios Propios (Requisito Rúbrica ES1) -->
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryDark">@color/primario_oscuro</item>
        <item name="colorSecondary">@color/secundario</item>
        <item name="colorOnPrimary">@color/texto_en_primario</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:windowBackground">@color/fondo_pantalla</item>
    </style>

    <!-- ESTILOS PROPIOS USADOS EN DOS O MÁS PANTALLAS (Requisito Rúbrica ES1) -->
    
    <!-- 1. Estilo para Tarjetas de Información y Rutinas (Usado en Lista, Detalle e IA) -->
    <style name="EstiloTarjetaGym" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">@color/fondo_tarjeta</item>
        <item name="strokeColor">@color/borde_tarjeta</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- 2. Estilo para Botones Principales de la App (Usado en Login, Registro, Agregar, etc.) -->
    <style name="EstiloBotonGym" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_en_primario</item>
        <item name="backgroundTint">@color/primario</item>
        <item name="android:minHeight">50dp</item>
    </style>

    <!-- 3. Estilo para Títulos Principales de Pantalla (Usado en las 6 pantallas) -->
    <style name="EstiloTituloPantalla">
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primario</item>
    </style>

    <!-- 4. Estilo para Etiquetas de Campos de Formulario (Usado en Login, Registro, Agregar) -->
    <style name="EstiloEtiquetaCampo">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/texto_secundario</item>
    </style>
</resources>