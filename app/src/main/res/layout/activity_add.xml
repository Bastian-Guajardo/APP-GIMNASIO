<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">

    <!-- Este contenedor lleva el padding, porque fitsSystemWindows lo pisa en la raiz -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

    <!-- Titulo de la pantalla -->
    <TextView
        android:id="@+id/txtTituloAgregar"
        style="@style/EstiloTituloPantalla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/titulo_agregar" />

    <TextView
        android:id="@+id/txtSubtituloAgregar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="18dp"
        android:text="@string/subtitulo_agregar"
        android:textColor="@color/texto_secundario"
        android:textSize="14sp" />

    <!-- Spinner: lista desplegable para elegir el grupo muscular -->
    <TextView
        android:id="@+id/txtEtiquetaGrupo"
        style="@style/EstiloEtiquetaCampo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:text="@string/etiqueta_grupo_muscular" />

    <Spinner
        android:id="@+id/spnGrupoMuscular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:entries="@array/grupos_musculares" />

    <TextView
        android:id="@+id/txtEtiquetaDisponibles"
        style="@style/EstiloEtiquetaCampo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="@string/etiqueta_ejercicios_disponibles" />

    <!-- ScrollView: deja desplazar los ejercicios cuando no caben en la pantalla -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Este LinearLayout parte vacio. Kotlin le va agregando una fila por ejercicio -->
        <LinearLayout
            android:id="@+id/layoutEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <!-- Boton para regresar a la lista -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverDeAgregar"
        style="@style/EstiloBotonGym"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/btn_volver_mi_lista" />

    </LinearLayout>

</LinearLayout>
