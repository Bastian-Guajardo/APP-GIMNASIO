<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">

    <!-- Barra de arriba: logo, titulo y boton del asistente -->
    <LinearLayout
        android:id="@+id/layoutBarraSuperior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_tarjeta"
        android:elevation="4dp"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/imgLogoBarra"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_gym_logo"
            android:contentDescription="@string/cd_logo_app" />

        <TextView
            android:id="@+id/txtTituloLista"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/titulo_lista_rutinas"
            android:textColor="@color/texto_primario"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirIA"
            style="@style/EstiloBotonGym"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_abrir_ia"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Mensaje que se ve solo cuando la lista esta vacia -->
    <TextView
        android:id="@+id/txtListaVacia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:padding="16dp"
        android:text="@string/mensaje_lista_vacia"
        android:textAlignment="center"
        android:textColor="@color/texto_secundario"
        android:textSize="15sp" />

    <!-- ScrollView: deja desplazar la lista cuando no cabe en la pantalla -->
    <ScrollView
        android:id="@+id/scrollViewRutinas"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Este LinearLayout parte vacio. Kotlin le agrega una fila por ejercicio guardado -->
        <LinearLayout
            android:id="@+id/layoutMisEjercicios"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp" />
    </ScrollView>

    <!-- Barra de abajo con los dos botones -->
    <LinearLayout
        android:id="@+id/layoutBarraInferior"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/fondo_tarjeta"
        android:orientation="horizontal"
        android:padding="12dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNuevaRutina"
            style="@style/EstiloBotonGym"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_nueva_rutina" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCerrarSesion"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_cerrar_sesion"
            android:textColor="@color/primario"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>
