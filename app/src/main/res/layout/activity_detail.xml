<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">

    <!-- Este contenedor lleva el padding, porque fitsSystemWindows lo pisa en la raiz -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

    <!-- Titulo de la pantalla -->
    <TextView
        android:id="@+id/txtTituloDetalle"
        style="@style/EstiloTituloPantalla"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/titulo_detalle" />

    <!-- Tarjeta con los datos del ejercicio -->
    <com.google.android.material.card.MaterialCardView
        style="@style/EstiloTarjetaGym"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Aqui Kotlin escribe el nombre del ejercicio que llego por el Intent -->
            <TextView
                android:id="@+id/txtDetalleNombre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:textColor="@color/texto_primario"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtEtiquetaSeries"
                style="@style/EstiloEtiquetaCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_etiqueta_series" />

            <TextView
                android:id="@+id/txtDetalleSeries"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="@string/detalle_series"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/txtEtiquetaDetalleDescanso"
                style="@style/EstiloEtiquetaCampo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/detalle_etiqueta_descanso" />

            <TextView
                android:id="@+id/txtDetalleDescanso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/detalle_descanso_ejemplo"
                android:textColor="@color/texto_primario"
                android:textSize="15sp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Boton para sacar el ejercicio de la lista -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnQuitarEjercicio"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:text="@string/btn_quitar_ejercicio"
        android:textColor="@color/color_peligro" />

    <!-- Boton para regresar a la lista -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnVolverLista"
        style="@style/EstiloBotonGym"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_volver_lista" />

    </LinearLayout>

</LinearLayout>
