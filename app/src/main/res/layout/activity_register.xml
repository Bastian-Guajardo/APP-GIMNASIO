<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- Logotipo -->
        <ImageView
            android:id="@+id/imgLogoRegistro"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_gym_logo"
            android:contentDescription="@string/cd_logo_app" />

        <!-- Titulo y subtitulo de la pantalla -->
        <TextView
            android:id="@+id/txtTituloRegistro"
            style="@style/EstiloTituloPantalla"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/titulo_registro"
            android:textAlignment="center" />

        <TextView
            android:id="@+id/txtSubtituloRegistro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="@string/subtitulo_registro"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:textAlignment="center" />

        <!-- Tarjeta que contiene el formulario -->
        <com.google.android.material.card.MaterialCardView
            style="@style/EstiloTarjetaGym"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Campo para el nombre -->
                <TextView
                    android:id="@+id/txtEtiquetaNombre"
                    style="@style/EstiloEtiquetaCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/etiqueta_nombre" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/hint_nombre"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNombre"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo para el correo -->
                <TextView
                    android:id="@+id/txtEtiquetaCorreoRegistro"
                    style="@style/EstiloEtiquetaCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/etiqueta_correo" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:hint="@string/hint_correo"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCorreoRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Campo para la contrasena -->
                <TextView
                    android:id="@+id/txtEtiquetaPasswordRegistro"
                    style="@style/EstiloEtiquetaCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/etiqueta_password" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    android:hint="@string/hint_password"
                    app:passwordToggleEnabled="true"
                    app:boxCornerRadiusBottomEnd="10dp"
                    app:boxCornerRadiusBottomStart="10dp"
                    app:boxCornerRadiusTopEnd="10dp"
                    app:boxCornerRadiusTopStart="10dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPasswordRegistro"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- RadioGroup: solo se puede marcar una opcion a la vez -->
                <TextView
                    android:id="@+id/txtPreguntaNivel"
                    style="@style/EstiloEtiquetaCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/pregunta_nivel_entrenamiento" />

                <RadioGroup
                    android:id="@+id/rgNivelEntrenamiento"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp">

                    <RadioButton
                        android:id="@+id/rbPrincipiante"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/rb_nivel_principiante"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbIntermedio"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rb_nivel_intermedio"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />

                    <RadioButton
                        android:id="@+id/rbAvanzado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rb_nivel_avanzado"
                        android:textColor="@color/texto_primario"
                        android:textSize="14sp" />
                </RadioGroup>

                <!-- CheckBox: aqui si se pueden marcar varias opciones -->
                <TextView
                    android:id="@+id/txtPreguntaEnfoque"
                    style="@style/EstiloEtiquetaCampo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:text="@string/pregunta_enfoque" />

                <CheckBox
                    android:id="@+id/cbFuerza"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_fuerza"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbDefinicion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/cb_definicion"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp" />

                <CheckBox
                    android:id="@+id/cbSalud"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:text="@string/cb_salud"
                    android:textColor="@color/texto_primario"
                    android:textSize="14sp" />

                <!-- Boton para crear la cuenta -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegistrar"
                    style="@style/EstiloBotonGym"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_registrarse" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Boton para regresar al login -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVolverLogin"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="@string/btn_volver_login"
            android:textColor="@color/primario"
            android:textSize="14sp" />

    </LinearLayout>
</ScrollView>
